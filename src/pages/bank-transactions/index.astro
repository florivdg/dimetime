---
import AppShell from '@/layouts/AppShell.astro'
import BankTransactionManager from '@/components/bank-transactions/BankTransactionManager.vue'
import { getBankTransactions, getImportSources } from '@/lib/bank-transactions'
import { getAllPlans } from '@/lib/plans'

// Load initial data server-side
const { rows, pagination } = await getBankTransactions({
  sortBy: 'bookingDate',
  sortDir: 'desc',
  page: 1,
  limit: 20,
})
const sources = await getImportSources()
const plans = await getAllPlans(true)
---

<AppShell heading="Kontoauszüge">
  <BankTransactionManager
    client:load
    initialRows={rows}
    initialPagination={pagination}
    initialSources={sources}
    initialPlans={plans}
  />
</AppShell>
