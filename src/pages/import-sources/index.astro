---
import AppShell from '@/layouts/AppShell.astro'
import ImportSourceManager from '@/components/import-sources/ImportSourceManager.vue'
import { getImportSources } from '@/lib/bank-transactions'
import { getImportTypes } from '@/lib/bank-import/service'

const sources = await getImportSources()
const importTypes = getImportTypes()
---

<AppShell heading="Import-Quellen">
  <ImportSourceManager
    client:load
    initialSources={sources}
    importTypes={importTypes}
  />
</AppShell>
