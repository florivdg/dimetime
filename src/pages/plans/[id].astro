---
import AppShell from '@/layouts/AppShell.astro'
import PlanDetailManager from '@/components/plans/PlanDetailManager.vue'
import { getPlanById } from '@/lib/plans'
import {
  getTransactions,
  getPlanBalance,
  getBudgetSpendingForPlan,
} from '@/lib/transactions'
import { getAllCategories } from '@/lib/categories'
import { getPlanDisplayName } from '@/lib/format'

const { id } = Astro.params

if (!id) {
  return Astro.redirect('/plans')
}

// Load plan
const plan = await getPlanById(id)

if (!plan) {
  return Astro.redirect('/plans')
}

// Load all data in parallel
const [{ transactions }, balance, budgetSpending, categories] =
  await Promise.all([
    getTransactions({
      planId: id,
      sortBy: 'dueDate',
      sortDir: 'asc',
      limit: -1,
    }),
    getPlanBalance(id),
    getBudgetSpendingForPlan(id),
    getAllCategories(),
  ])

const planDisplayName = getPlanDisplayName(plan.name, plan.date)
---

<AppShell
  title={planDisplayName}
  breadcrumbs={[{ label: 'Pläne', href: '/plans' }, { label: planDisplayName }]}
>
  <PlanDetailManager
    client:load
    plan={plan}
    initialTransactions={transactions}
    initialBalance={balance}
    initialBudgetSpending={budgetSpending}
    categories={categories}
  />
</AppShell>
