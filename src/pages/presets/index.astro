---
import AppShell from '@/layouts/AppShell.astro'
import PresetManager from '@/components/presets/PresetManager.vue'
import { getPresets } from '@/lib/presets'
import { getAllCategories } from '@/lib/categories'

const userId = Astro.locals.user?.id
if (!userId) {
  return Astro.redirect('/login')
}

// Fetch initial data
const presetsData = await getPresets({
  page: 1,
  limit: 20,
  includeExpired: false,
})
const categories = await getAllCategories()
---

<AppShell heading="Transaktionsvorlagen" breadcrumbs={[{ label: 'Vorlagen' }]}>
  <PresetManager
    client:load
    initialPresets={presetsData.presets}
    initialPagination={presetsData.pagination}
    categories={categories}
  />
</AppShell>
