---
import AppShell from '@/layouts/AppShell.astro'
import TransactionManager from '@/components/transactions/TransactionManager.vue'
import {
  getBudgetSpendingForBudgets,
  getTransactions,
} from '@/lib/transactions'
import { getAllCategories } from '@/lib/categories'
import { getAllPlans } from '@/lib/plans'

// Load initial data server-side
const { transactions, pagination } = await getTransactions({
  sortBy: 'dueDate',
  sortDir: 'desc',
  page: 1,
  limit: 20,
})
const budgetIds = transactions.filter((t) => t.isBudget).map((t) => t.id)
const initialBudgetSpending =
  budgetIds.length > 0 ? await getBudgetSpendingForBudgets(budgetIds) : {}
const categories = await getAllCategories()
const plans = await getAllPlans(true) // Include archived plans for filter
---

<AppShell heading="Transaktionen">
  <TransactionManager
    client:load
    initialTransactions={transactions}
    initialPagination={pagination}
    initialBudgetSpending={initialBudgetSpending}
    categories={categories}
    plans={plans}
  />
</AppShell>
